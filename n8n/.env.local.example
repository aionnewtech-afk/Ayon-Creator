# n8n dedicado ao Ayon Creator — ver n8n/docker-compose.yml.
# Copiar para n8n/.env.local (gitignored, mesmo padrão de .env.local.example
# na raiz do projeto) e preencher.

# Chave de criptografia das credenciais salvas no n8n (workflows, credenciais
# de nó). PERDER ESTA CHAVE = perder acesso a tudo que estiver criptografado
# no volume — gerar uma vez com `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
# e nunca trocar depois que o volume já tiver dados.
N8N_ENCRYPTION_KEY=
