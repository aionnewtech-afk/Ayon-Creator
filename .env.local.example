# Supabase — apps/web (público)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — apenas server-side (nunca expor ao client)
SUPABASE_SERVICE_ROLE_KEY=

# LLM Provider (Missão 2 — "Conheça sua empresa") — apenas server-side
ANTHROPIC_API_KEY=

# Troca temporária de fornecedor LLM (ex.: conta Anthropic sem créditos) —
# "anthropic" (padrão, deixar vazio) ou "gemini" (via camada OpenAI-compatible
# do Gemini para a capacidade `llm`; a busca web do Trend Engine usa a API
# nativa do Gemini quando LLM_PROVIDER=gemini, já que a camada OpenAI-compatible
# não expõe grounding/busca). Ver packages/core/src/providers/provider-gateway.ts.
LLM_PROVIDER=
GEMINI_API_KEY=
# Modelo de baixo custo, adequado para texto/JSON estruturado — trocar aqui
# sem editar código se o nome do modelo mudar. "gemini-2.5-flash"/"gemini-2.0-flash"
# (achado real, testado direto na API) retornam 404 "no longer available to
# new users/no longer available" — usar "gemini-3-flash-preview" (verificado
# funcionando: JSON estrito, custo baixo) até a Google estabilizar uma versão
# não-preview.
GEMINI_MODEL=gemini-3-flash-preview

# Billing (Missão 6) — Mercado Pago, apenas server-side
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Voice Provider (Missão 9, Etapa 1) — ElevenLabs, apenas server-side
ELEVENLABS_API_KEY=

# Media Provider (Missão 9, Etapa 1) — Pexels, apenas server-side
PEXELS_API_KEY=

# Geração de foto para feed/stories/thumbnail via Gemini, em vez de busca no
# banco do Pexels (achado real, pedido direto do usuário: foto de banco
# genérica "nada a ver" com o gancho comercial/emocional da campanha) —
# "gemini" ativa, deixar vazio mantém o Pexels (padrão, 100% reversível). Só
# afeta a foto (thumbnail/stories/carousel) — o vídeo continua usando Pexels
# sempre. Ver packages/core/src/providers/provider-gateway.ts
# (resolveImageGenerationMediaProvider).
IMAGE_GENERATION_PROVIDER=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Geração de vídeo (Veo) como 3ª camada do fallback de cenas do vídeo — só
# entra quando o Pexels não acha nenhuma cena nova E a geração de vídeo está
# ligada (achado real, pedido direto do usuário depois de aprovar um teste
# real pago). AO CONTRÁRIO da imagem acima, cobra por segundo de vídeo (Veo
# 3.1: Standard ~$0.40/s, Fast ~$0.10-0.12/s, Lite ~$0.05-0.08/s — Lite é o
# padrão aqui, escolhido pelo usuário) e pode levar minutos por geração — por
# isso é uma env var própria, nunca acoplada a IMAGE_GENERATION_PROVIDER.
# "gemini" ativa, deixar vazio mantém só Pexels + imagem gerada (padrão,
# 100% reversível). Ver provider-gateway.ts (resolveVeoVideoProvider) e
# video-pipeline-scenes.ts (no máximo 1 geração por vídeo, nunca várias
# esperas longas em série).
VIDEO_GENERATION_PROVIDER=
GEMINI_VIDEO_MODEL=veo-3.1-lite-generate-preview

# Avatar Provider — HeyGen ("digital twin" do porta-voz da marca), apenas
# server-side. Fallback/bootstrap: usado direto quando `heygen_account_pool`
# está vazio (migration 0026); com o pool em uso, cada organização recebe sua
# própria conta (ver provider-gateway.ts, resolveAvatarProvider).
HEYGEN_API_KEY=

# Video Render Provider (Missão 9, Etapa 1) — Shotstack, apenas server-side
SHOTSTACK_API_KEY=
# Base URL completa incluindo o estágio — sandbox: https://api.shotstack.io/edit/stage
# produção: https://api.shotstack.io/edit/v1
SHOTSTACK_HOST=https://api.shotstack.io/edit/stage

# Orquestração do pipeline de vídeo (Missão 9, Etapa 1, Fluxo 13) — apenas server-side
# URL do webhook do n8n que recebe o disparo do pipeline — vazio até o n8n ser provisionado.
N8N_WEBHOOK_URL=
# Segredo compartilhado — autentica tanto o disparo (nós → n8n) quanto o
# callback de conclusão e as rotas internas do pipeline (n8n → nós).
N8N_WEBHOOK_SECRET=

# apps/web — 3010 é a porta oficial (fixada em apps/web/package.json,
# `next dev -p 3010`/`next start -p 3010`); o workflow n8n chama de volta
# nessa porta (`http://host.docker.internal:3010/...`, ver n8n/README.md).
NEXT_PUBLIC_APP_URL=http://localhost:3010
